{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-vehicleshop/data/settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    },
    "accounts": {
      "description": "Accounts: Tried in this order until one has enough money.",
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 32,
        "pattern": "^[a-z0-9_]{2,32}$"
      }
    },
    "blip": {
      "description": "Shop",
      "type": "object",
      "properties": {
        "sprite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2
        }
      },
      "required": [
        "sprite",
        "color",
        "scale"
      ]
    },
    "bikeBlip": {
      "description": "Motorcycle shop: A shop that sells only the motorcycles category.",
      "type": "object",
      "properties": {
        "sprite": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "scale": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 2
        }
      },
      "required": [
        "sprite",
        "color",
        "scale"
      ]
    }
  },
  "required": []
}
